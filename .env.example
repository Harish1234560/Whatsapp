# Copy to .env and fill in. Never commit .env.

NODE_ENV=development
PORT=4100

# The EXISTING store database (PostgreSQL). Use the least-privilege role from sql/create-marketing-role.sql.
# Leave empty to run on an embedded demo database with fake customers and orders.
DATABASE_URL=
# Optional: keep the embedded demo database between restarts.
PGLITE_DIR=

# Where the store's table and column names are mapped.
SCHEMA_MAPPING_FILE=schema-mapping.json

# Required in production: 32+ random characters.  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=
# Let the store's own ADMIN users sign in to the marketing dashboard (their bcrypt hashes are read, never written).
ALLOW_STORE_ADMIN_LOGIN=true

# existing_table: marketing coupons are copied into the store's coupon table at approval. Checkout needs no change.
# api:            checkout calls POST /api/integration/coupons/validate and /redeem. Enforces one customer per coupon.
COUPON_MODE=existing_table
# 24+ characters. The store sends it as the x-api-key header on /api/integration/* calls.
INTEGRATION_API_KEY=

# mock: nothing is sent, everything is recorded. Refused when NODE_ENV=production.
# cloud: the official WhatsApp Business Cloud API. Refused when NODE_ENV=test.
WHATSAPP_PROVIDER=mock
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_WABA_ID=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_API_VERSION=v21.0

# Empty: in-process queue (fine for one server). Set to use BullMQ, e.g. redis://localhost:6379
REDIS_URL=
SEND_RATE_PER_SECOND=20

ENABLE_SCHEDULER=true
